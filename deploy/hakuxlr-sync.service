[Unit]
Description=Publish the hakuX-lr compatibility page from GitHub main
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=hakuxlr
Group=hakuxlr
StateDirectory=hakuxlr-sync
Environment=HOME=/var/lib/hakuxlr-sync
ExecStart=/usr/local/bin/hakuxlr-sync
TimeoutStartSec=10min
Nice=10
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/www/hakuxlr
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
