# Full captures stay on the test machine: from each game's run directory only
# result.json is kept (media/ has the thumbnails).
/runs/*/*/*
!/runs/*/*/result.json
/runs/*/claims/
# queues list the CHDs by their path on the test machine
/runs/queue-*.txt

# cores, local work and generated views of the full captures
/cores/
/fixwork/
/contact-sheets/
/report.html
*.bak*
*.tmp
__pycache__/
# worker console output (paths on the test machine)
/runs/*.out
/runs/*.log
