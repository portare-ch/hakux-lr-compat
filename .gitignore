# Keep result.json and thumbnails; full captures stay on the test machine.
/runs/*/*/*
!/runs/*/*/result.json
/runs/*/claims/
# Queue paths are local to the test machine.
/runs/queue-*.txt

# Local cores, work files and generated capture views.
/cores/
/fixwork/
/contact-sheets/
/report.html
*.bak*
*.tmp
__pycache__/
# Local worker logs.
/runs/*.out
/runs/*.log
